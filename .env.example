# ---------------------------------------------------------------------------
# Studio One - environment variables
# Copy this file to `.env` (root) and fill the values.
# This file is the single source of truth for Docker Compose (dev + prod build).
# ---------------------------------------------------------------------------

# Application environment: mockable | development | production
VITE_ENVIRONMENT=development

# Base URL of the application API (used by the axios client)
VITE_API_URL=http://localhost/api

# Firebase web app configuration.
# Get it from: Firebase console > Project settings > General > Your apps > SDK setup and configuration
# NOTE: the Firebase web configuration is public by design (it ships to the browser).
# Protect it by restricting the API key and the authorized domains in the Firebase console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Firebase Auth Emulator URL (leave empty to use the real service)
VITE_FIREBASE_AUTH_EMULATOR_URL=
