# ---------------------------------------------------------------------------
# Studio One - frontend environment variables
# Copy this file to `.env` (same folder) when running the app outside Docker.
# Inside Docker the values come from the `.env` file at the repository root.
# ---------------------------------------------------------------------------

VITE_ENVIRONMENT=development
VITE_API_URL=http://localhost/api

# Firebase web app configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Firebase Auth Emulator URL
VITE_FIREBASE_AUTH_EMULATOR_URL=
